# =============================================================
# SOCIAL SPY - 環境変数サンプル
# .env.local にコピーして使用してください（.env.local はコミットしない）
# =============================================================

# -------------------------------------------------------------
# 1. 動作モード
# -------------------------------------------------------------
# デモモードは「Supabase が未設定」かつ「本番デプロイでない」場合に既定で有効です。
# そのため .env.local が無くても `npm run dev` でデモを確認できます。
#
#  - Supabase の3変数を設定すると自動的にデモモードは無効になります
#  - 本番デプロイ（VERCEL_ENV=production もしくは SPY_ENV=production）では
#    SPY_ALLOW_DEMO_IN_PRODUCTION=true を明示しない限り有効になりません
#  - 明示的に無効化したい場合は NEXT_PUBLIC_DEMO_MODE=false を指定します
NEXT_PUBLIC_DEMO_MODE=true
SPY_ALLOW_DEMO_IN_PRODUCTION=false
# 本番デプロイであることを明示したい場合（Vercel以外のホスティング等）
# SPY_ENV=production

# -------------------------------------------------------------
# 2. 参加者セッション署名鍵（必須 / 32文字以上）
#    参加者の httpOnly Cookie を HMAC 署名するために使用します。
#    例: openssl rand -hex 32
# -------------------------------------------------------------
SPY_SESSION_SECRET=change-me-to-a-random-32-plus-character-string

# -------------------------------------------------------------
# 3. Supabase（本番運用時に設定）
#    3つすべてが設定されると自動的に Supabase モードになります。
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE ROLE KEY は必ずサーバー側のみ。NEXT_PUBLIC_ を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# 4. 参加用URL/QRコードのベースURL
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# 5. デモ用管理者ログイン（デモモード時のみ有効）
# -------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@socialspy.demo
DEMO_ADMIN_PASSWORD=spy-demo-2026

# -------------------------------------------------------------
# 6. プッシュ通知（PWA / 任意）
#    「SPY MISSION公開」「投票開始」を端末の通知として届けます。
#    未設定の場合、通知機能はUIごと自動的に無効になります。
#
#    鍵の生成:  npx web-push generate-vapid-keys
#    ※ 秘密鍵は絶対にクライアントへ渡さないこと（NEXT_PUBLIC_ を付けない）
# -------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
